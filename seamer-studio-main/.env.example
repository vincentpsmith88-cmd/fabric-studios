# Seamer Studio environment
#
# Static GitHub Pages-style deployment:
#   pnpm build
# Optional base path for hosting below a URL prefix:
#   BASE_PATH=/your-prefix
#
# Self-hosted Node deployment:
#   pnpm build:server
#   SEAMER_DATA_DIR=/absolute/private/path
#   ORIGIN=https://your-domain.example
#   BODY_SIZE_LIMIT=13M
#
# Keep SEAMER_DATA_DIR outside the public web root. The current collaboration
# store is file-backed and documented as single-process; do not share this
# directory between multiple app instances.
#
# These are runtime/build variables, not secrets to commit. Do not put private
# API keys in VITE_ or PUBLIC_ variables because those are exposed to browsers.
